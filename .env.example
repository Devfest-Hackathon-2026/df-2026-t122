# ====================================================
# YouTube Data API v3 設定
# ====================================================
# Google Cloud Consoleで発行したYouTube Data API v3のAPIキーを設定してください。
# ※ 本ファイルはGitにコミットされます。実際のAPIキーは .env.local に記載してください。
VITE_YOUTUBE_API_KEY=

# 開発用モックモード
# true に設定した場合のみ、APIキーなしでモックデータが返却されます。
# false または未設定の場合は実際の YouTube Data API v3 を呼び出します。
VITE_USE_MOCK_YOUTUBE=false

# (将来用) Cloud Run等のプロキシAPIエンドポイント
# 設定した場合、直接 Google API を叩く代わりに指定のベースURLへリクエストを送信します。
# VITE_YOUTUBE_API_BASE_URL=https://your-cloud-run-service.a.run.app/api/youtube
